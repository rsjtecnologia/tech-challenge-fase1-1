{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Executar dashboard com Ollama local",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& .\\scripts\\start_ollama.ps1; if ($?) { & .\\run_web.ps1 }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "inAgents": true
    }
  ]
}
